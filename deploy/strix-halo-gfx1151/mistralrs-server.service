[Unit]
Description=mistral.rs Server (Strix Halo gfx1151)
#StartLimitIntervalSec=120
#StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/LocalAI
# Validate the TOML with the real serde schema before every start: a bad
# edit fails the job once, loudly, instead of crash-looping on Restart=
# (Oct 8: ~70 restarts on a duplicate key; Oct 9: ~65 on a bad enum
# variant). Pre-start failure does not trigger Restart=.
ExecStartPre=%h/LocalAI/mistral.rs/target/release/mistralrs from-config -f %h/LocalAI/models/mistralrs.toml --dry-run
ExecStart=%h/.config/mistralrs-server-wrapper.sh
LimitMEMLOCK=infinity
# SEGV cores for the fault hunt: the default soft limit is 0 (writes
# nothing), and core_pattern used to pipe to apport, which refuses
# user-session cores from private mount namespaces (lost the 2026-10-13
# idle-SEGV core). Pattern now points at LocalAI/scratch/cores.
LimitCORE=infinity
Restart=on-failure
RestartSec=5
TimeoutStopSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
